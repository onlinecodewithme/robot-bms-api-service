[Unit]
Description=BMS REST API Service
Documentation=file:///home/x4mc1/Documents/robot-bms-api-service/README.md
After=network-online.target bms-background.service
Wants=network-online.target
Requires=bms-background.service

[Service]
Type=simple
User=x4mc1
Group=x4mc1
WorkingDirectory=/home/x4mc1/Documents/robot-bms-api-service
Environment=PATH=/home/x4mc1/Documents/robot-bms-api-service/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FLASK_APP=bms_api_service.py
Environment=FLASK_ENV=production
ExecStart=/home/x4mc1/Documents/robot-bms-api-service/venv/bin/python /home/x4mc1/Documents/robot-bms-api-service/bms_api_service.py --host 0.0.0.0 --port 5000 --data-file /home/x4mc1/Documents/robot-bms-api-service/bms_data/bms_latest.json --status-file /home/x4mc1/Documents/robot-bms-api-service/bms_data/bms_status.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bms-api

# Security settings
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
ReadWritePaths=/home/x4mc1/Documents/robot-bms-api-service/bms_data

# Resource limits
MemoryMax=128M
CPUQuota=25%

# Network access for HTTP server
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16

[Install]
WantedBy=multi-user.target